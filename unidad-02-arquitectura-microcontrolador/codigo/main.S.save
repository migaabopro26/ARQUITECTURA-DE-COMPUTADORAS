#include <avr/io.h>

.section .text
.global main

main:
    ; 1. Configurar LEDs (PB0, PB1, PB2) como salidas
    ldi r16, 0x07
    out _SFR_IO_ADDR(DDRB), r16

    ; 2. Configurar Switches (PC4, PC5) como entradas
    ldi r16, 0x02
    out _SFR_IO_ADDR(DDRC), r16      ; Puerto C como entrada
    
    ; 3. Activar resistencias Pull-up en PC4 y PC5 para que lean '1' al estar abiertos
    ldi r16, 0b000000011              
    out _SFR_IO_ADDR(PORTC), r16

MAIN_LOOP:
    ; --- Paso 1: Encender D1 (PB0) ---
    ldi r16, 0b00000001
    out _SFR_IO_ADDR(PORTB), r16
    rcall LEER_SWITCHES_Y_ESPERAR    ; Llamamos a la nueva subrutina

    ; --- Paso 2: Encender D2 (PB1) ---
    ldi r16, 0b00000010
    out _SFR_IO_ADDR(PORTB), r16
    rcall LEER_SWITCHES_Y_ESPERAR

    ; --- Paso 3: Encender D3 (PB2) ---
    ldi r16, 0b00000100
    out _SFR_IO_ADDR(PORTB), r16
    rcall LEER_SWITCHES_Y_ESPERAR

    ; --- Paso 4: Regresar a D2 (PB1) ---
    ldi r16, 0b00000010
    out _SFR_IO_ADDR(PORTB), r16
    rcall LEER_SWITCHES_Y_ESPERAR

    rjmp MAIN_LOOP                   ; Repetir el péndulo infinito


; ====================================================================
; SUBRUTINA: Lee los switches, define la velocidad (r18) y hace la pausa
; ====================================================================
LEER_SWITCHES_Y_ESPERAR:
    ; Leer todo el Puerto C (PINC)
    in r17, _SFR_IO_ADDR(PINC)   
    
    ; Máscara: Borrar todos los bits excepto PC4 y PC5 (0b00110000)
    andi r17, 0b00110000         

    ; --- Evaluar Estado 00 (Ambos cerrados a tierra) -> Ultra Lento ---
    cpi r17, 0b00000000
    breq ESTADO_00

    ; --- Evaluar Estado 01 (PC4 abierto, PC5 cerrado) -> Lento ---
    ; PC4 es el bit 4 (00010000 en binario, que es 0x10)
    cpi r17, 0b000000001
    breq ESTADO_01

    ; --- Evaluar Estado 10 (PC4 cerrado, PC5 abierto) -> Rápido ---
    ; PC5 es el bit 5 (00100000 en binario, que es 0x20)
    cpi r17, 0b00100000
    breq ESTADO_10

    ; --- Si no fue ninguno de los 3 anteriores, es Estado 11 (Ambos abiertos) ---
    rjmp ESTADO_11

; --- Asignación de velocidades a r18 ---
ESTADO_00:  
    ldi r18, 0xC0  ; Numero más grande = Ultra lento
    rjmp EJECUTAR_DELAY

ESTADO_01:  
    ldi r18, 0x60  ; Lento
    rjmp EJECUTAR_DELAY

ESTADO_10:  
    ldi r18, 0x20  ; Rápido
    rjmp EJECUTAR_DELAY

ESTADO_11:  
    ldi r18, 0x02  ; Numero más chico = Ultra rápido (casi ni se ve)

EJECUTAR_DELAY:
    ; Aquí inicia tu Delay original, pero r18 ya tiene la velocidad correcta
DELAY1:
    ldi r19, 0xFF
DELAY2:
    ldi r20, 0xFF
DELAY3:
    dec r20
    brne DELAY3
    dec r19
    brne DELAY2
    dec r18
    brne DELAY1
    ret
